{
    "name": "criminal-cert-service",
    "version": "1.0.0",
    "description": "Criminal Record Certificate service",
    "author": "Diia",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": "https://github.com/diia-open-source/be-criminal-cert-service.git",
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "prepare": "ts-patch install -s",
        "build": "rimraf dist/ && mkdir dist && npm run genproto && tsc",
        "start": "node dist/index.js",
        "semantic-release": "semantic-release",
        "lint": "eslint --ext .ts . && prettier --check .",
        "lint-fix": "eslint --ext .ts --fix . && prettier --write .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
        "test:integration": "npm run test --selectProjects integration --",
        "test:unit": "npm run test --selectProjects unit --",
        "migrate-deploy": "npm run migrate up",
        "migrate-ci": "npm run migrate up",
        "migrate-test": "NODE_ENV=test npm run migrate up",
        "migrate": "sh -c 'ts-node --project migrations/tsconfig.json node_modules/.bin/migrate-mongo $0 $1 -f migrate-mongo-config.ts'",
        "indexes:sync": "MONGO_INDEXES_SYNC=true MONGO_INDEXES_EXIT_AFTER_SYNC=true npm run start",
        "find-circulars": "madge --circular --extensions ts ./",
        "scaffold": "scaffold",
        "genproto": "genproto --outputDir src/generated"
    },
    "keywords": [],
    "engines": {
        "node": ">=18"
    },
    "_moduleAliases": {
        "@services": "dist/services",
        "@interfaces": "dist/interfaces",
        "@models": "dist/models",
        "@actions": "dist/actions",
        "@src": "dist",
        "@tests": "tests"
    },
    "jest": {
        "preset": "@diia-inhouse/configs/dist/jest"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "eslintConfig": {
        "extends": "@diia-inhouse/eslint-config",
        "parserOptions": {
            "project": [
                "./tsconfig.json",
                "./tests/tsconfig.json",
                "./migrations/tsconfig.json"
            ]
        }
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/service"
    },
    "prettier": "@diia-inhouse/eslint-config/prettier",
    "madge": {
        "tsConfig": "./tsconfig.json"
    },
    "dependencies": {
        "@diia-inhouse/address-service-client": "1.0.0-118331",
        "@diia-inhouse/analytics": "1.61.0",
        "@diia-inhouse/analytics-service-client": "1.0.0-121540",
        "@diia-inhouse/crypto": "1.11.0",
        "@diia-inhouse/db": "4.10.0",
        "@diia-inhouse/diia-app": "18.0.0",
        "@diia-inhouse/diia-crypto-client": "1.0.0-94617",
        "@diia-inhouse/diia-logger": "3.2.0",
        "@diia-inhouse/diia-metrics": "3.12.0",
        "@diia-inhouse/diia-queue": "8.0.0",
        "@diia-inhouse/documents-service-client": "1.0.0-121521",
        "@diia-inhouse/env": "1.16.0",
        "@diia-inhouse/errors": "1.10.0",
        "@diia-inhouse/healthcheck": "1.12.0",
        "@diia-inhouse/http": "1.9.0",
        "@diia-inhouse/notification-service-client": "1.0.0-121722",
        "@diia-inhouse/public-service-catalog-client": "1.0.0-136924",
        "@diia-inhouse/public-service-service-client": "1.0.0-119061",
        "@diia-inhouse/redis": "2.19.0",
        "@diia-inhouse/types": "6.30.0",
        "@diia-inhouse/user-service-client": "1.0.0-133769",
        "@diia-inhouse/utils": "3.5.0",
        "@diia-inhouse/validators": "1.17.0",
        "adm-zip": "0.5.10",
        "lodash": "4.17.21",
        "migrate-mongo": "11.0.0",
        "module-alias": "2.2.3",
        "moment": "2.29.4"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "1.32.0",
        "@diia-inhouse/eslint-config": "5.1.0",
        "@diia-inhouse/genproto": "1.14.0",
        "@diia-inhouse/scaffold": "2.19.1",
        "@diia-inhouse/test": "6.4.0",
        "@types/adm-zip": "0.5.1",
        "@types/jest": "29.5.12",
        "@types/lodash": "4.17.5",
        "@typescript-eslint/eslint-plugin": "7.8.0",
        "eslint": "8.57.0",
        "eslint-plugin-jest": "28.6.0",
        "eslint-plugin-unicorn": "54.0.0",
        "jest": "29.5.0",
        "lockfile-lint": "4.14.0",
        "madge": "7.0.0",
        "prettier": "3.3.2",
        "rimraf": "5.0.7",
        "semantic-release": "21.1.2",
        "ts-node": "10.9.2",
        "ts-patch": "2.1.0",
        "type-fest": "4.8.3",
        "typescript": "5.5.2",
        "typescript-transform-paths": "3.4.7"
    }
}
